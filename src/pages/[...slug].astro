---
import { getCollection, render } from 'astro:content';
import DocLayout from '../layouts/DocLayout.astro';
import Toc from '../components/Toc.astro';
import PrevNext from '../components/PrevNext.astro';
import Comments from '../components/Comments.astro';
import { prevNext } from '../data/nav';

export async function getStaticPaths() {
  const docs = await getCollection('docs');
  return docs
    .filter((e) => e.id !== 'home' && !e.data.draft)
    .map((entry) => ({
      // Astro 7 的 catch-all 参数为带斜杠的字符串，如 'for-mom/create-wallet/random'
      params: { slug: entry.id },
      props: { entry },
    }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const route = entry.id;
const isEmpty = !(entry.body ?? '').trim();
const pn = prevNext(route);
---

<DocLayout
  title={entry.data.title}
  description={entry.data.description}
  route={route}
  date={entry.data.date}
  updated={entry.data.updated}
>
  {
    isEmpty ? (
      <div class="page-empty">
        <h1 class="page-title">{entry.data.title}</h1>
        <div class="page-placeholder">内容待添加</div>
      </div>
    ) : (
      <>
        <h1 class="page-title">{entry.data.title}</h1>
        <Toc headings={headings} />
        <article class="md">
          <Content />
        </article>
        <PrevNext prev={pn.prev} next={pn.next} />
        <Comments />
      </>
    )
  }
</DocLayout>
