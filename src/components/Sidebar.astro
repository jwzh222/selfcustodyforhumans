---
import { NAV } from '../data/nav';
import type { NavSection, NavGroup, NavLeaf } from '../data/nav';

interface Props {
  route: string; // 当前路由（不带首尾斜杠），用于高亮
}

const { route } = Astro.props;
const isActive = (path: string) => route === path || route.startsWith(path + '/');

function sectionClasses(section: NavSection): string {
  let cls = 'section ';
  if (section.accent) cls += 'section--accent';
  else if (section.indented) cls += 'section--plain section--indented';
  else cls += 'section--plain';
  if (section.children?.length) cls += ' has-children';
  if (section.bordered === 'bottom') cls += ' nav-row--border-bottom';
  else if (section.bordered) cls += ' nav-row--bordered';
  return cls;
}

const leafClasses = (mono: boolean, active: boolean) =>
  'nav-leaf' + (mono ? ' nav-leaf--mono' : '') + (active ? ' is-active' : '');
---

<a class="sidebar__brand" href="/" title="回到首页">
  <span class="sidebar__brand-name">Self custody</span>
  <img class="sidebar__brand-icon" src="/assets/logo-icon.svg" alt="Self custody" />
</a>
<nav class="sidebar__nav" id="nav" aria-label="目录导航">
  {
    NAV.map((section) => {
      const hasChildren = !!section.children?.length;
      return (
        <div
          class={sectionClasses(section)}
          id={`section-${section.id}`}
          data-section={section.id}
          data-force-open={isActive(section.id) ? 'true' : undefined}
        >
          {hasChildren ? (
            <>
              <div
                class="section-head"
                role="button"
                tabindex="0"
                aria-expanded="true"
                aria-controls={`${section.id}-children`}
              >
                <img class="chev" src={section.accent ? '/assets/chevron.svg' : '/assets/chevron-2.svg'} alt="" aria-hidden="true" />
                {section.icon && (
                  <img
                    class={'section-head__icon' + (section.iconClass ? ` section-head__icon--${section.iconClass}` : '')}
                    src={section.icon}
                    alt=""
                    aria-hidden="true"
                  />
                )}
                <span class="section-head__label">{section.label}</span>
              </div>
              <div class="section-children" id={`${section.id}-children`}>
                {section.children!.map((sub) => {
                  if ('children' in sub && sub.children) {
                    const group = sub as NavGroup;
                    const groupRoute = group.href?.replace(/^\//, '');
                    const groupActive = groupRoute
                      ? route === groupRoute || route.startsWith(`${section.id}/${group.id}/`)
                      : route.startsWith(`${section.id}/${group.id}/`);
                    return (
                      <>
                        {group.href ? (
                          <a
                            class={'subsection subsection--link' + (groupActive ? ' is-active' : '')}
                            href={group.href}
                          >
                            {group.label}
                          </a>
                        ) : (
                          <div class={'subsection' + (groupActive ? ' is-active' : '')}>{group.label}</div>
                        )}
                        <div class="subsection-children">
                          {group.children.map((child) => {
                            // 二级嵌套分组（如 助记词 下再分两子节）
                            if ('children' in child && child.children) {
                              const sub2 = child as NavGroup;
                              const sub2Route = sub2.href?.replace(/^\//, '');
                              const sub2Active = sub2Route
                                ? route === sub2Route || route.startsWith(`${section.id}/${group.id}/${sub2.id}/`)
                                : route.startsWith(`${section.id}/${group.id}/${sub2.id}/`);
                              return (
                                <div class="subsection-nested">
                                  {sub2.href ? (
                                    <a
                                      class={'subsection subsection--link' + (sub2Active ? ' is-active' : '')}
                                      href={sub2.href}
                                    >
                                      {sub2.label}
                                    </a>
                                  ) : (
                                    <div class={'subsection' + (sub2Active ? ' is-active' : '')}>{sub2.label}</div>
                                  )}
                                  <div class="subsection-children">
                                    {sub2.children.map((leaf: NavLeaf) => {
                                      const leafRoute = `${section.id}/${group.id}/${sub2.id}/${leaf.id}`;
                                      return (
                                        <a class={leafClasses(!!leaf.mono, route === leafRoute)} href={`/${leafRoute}`}>
                                          {leaf.label}
                                        </a>
                                      );
                                    })}
                                  </div>
                                </div>
                              );
                            }
                            // 直接叶子（如 passphrase）
                            const leaf = child as NavLeaf;
                            const leafRoute = `${section.id}/${group.id}/${leaf.id}`;
                            return (
                              <a class={leafClasses(!!leaf.mono, route === leafRoute)} href={`/${leafRoute}`}>
                                {leaf.label}
                              </a>
                            );
                          })}
                        </div>
                      </>
                    );
                  }
                  const leaf = sub as NavLeaf;
                  return (
                    <a
                      class={leafClasses(!!leaf.mono, route === `${section.id}/${leaf.id}`)}
                      href={`/${section.id}/${leaf.id}`}
                    >
                      {leaf.label}
                    </a>
                  );
                })}
              </div>
            </>
          ) : (
            <a class={'section-head' + (route === section.id ? ' is-active' : '')} data-route={section.id} href={`/${section.id}`}>
              <img class="chev" src="/assets/chevron-2.svg" alt="" aria-hidden="true" />
              {section.icon && (
                <img
                  class={'section-head__icon' + (section.iconClass ? ` section-head__icon--${section.iconClass}` : '')}
                  src={section.icon}
                  alt=""
                  aria-hidden="true"
                />
              )}
              <span class="section-head__label">{section.label}</span>
            </a>
          )}
        </div>
      );
    })
  }
</nav>
